<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained Linux build for the VPS: bundles the .NET runtime, so nothing
  needs installing on the server. ReadyToRun precompiles for a faster start.
  Usage:  dotnet publish -p:PublishProfile=linux-x64
  Output: bin/publish/linux-x64/  (includes this machine's appsettings.json —
          copy it to the server privately, never commit it)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>bin/publish/linux-x64/</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
