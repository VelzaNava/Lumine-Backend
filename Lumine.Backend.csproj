<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lumine.Backend</RootNamespace>
    <!-- No culture-specific logic here, and invariant mode removes the ICU
         dependency on the Linux server. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- XML doc comments feed the OpenAPI document shown in the API docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- The test project lives inside this folder; keep it out of the app build. -->
  <ItemGroup>
    <Compile Remove="Lumine.Backend.Tests/**" />
    <Content Remove="Lumine.Backend.Tests/**" />
    <None Remove="Lumine.Backend.Tests/**" />
    <EmbeddedResource Remove="Lumine.Backend.Tests/**" />
  </ItemGroup>

  <!-- Only the real appsettings.json belongs on the server. -->
  <ItemGroup>
    <Content Update="appsettings.example.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumine.Backend.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.10" />
  </ItemGroup>

</Project>
